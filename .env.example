# 默认 mock：离线、确定性、不需要密钥。pytest 与 README 命令都走 mock。
AGENT_MODEL=mock

# 可选 api 入口。填写本机环境变量，不要把密钥提交进仓库。
# DeepSeek 示例：OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# 切换：python -m src.main --model api --case normal
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
